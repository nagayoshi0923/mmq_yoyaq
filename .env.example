# =============================================================================
# 環境変数テンプレート
# 
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase設定
# -----------------------------------------------------------------------------
# 本番: https://cznpcewciwywcqcxktba.supabase.co
# ステージング: https://<staging-project>.supabase.co
# ローカル: http://localhost:54321
VITE_SUPABASE_URL=

# Supabase Anon Key（公開可能なキー）
VITE_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# AI Manager gateway（秘密値をリポジトリへ保存しない）
# -----------------------------------------------------------------------------
# AI Managerへ渡す平文トークンではなくSHA-256 hashだけを設定する。
AI_MANAGER_GATEWAY_TOKEN_SHA256=
AI_MANAGER_ORGANIZATION_ID=
AI_MANAGER_ALLOWED_OPERATIONS=schedule.read,sales.read,scenarios.read,license-contracts.read,external-reports.read,license-partner-reports.read,staff-scenario-assignments.read,gm-availability-responses.read
AI_MANAGER_SERVICE_EMAIL=
AI_MANAGER_SERVICE_PASSWORD=
# 通常は現在のVercel hostから解決する。固定する場合だけ設定する。
AI_MANAGER_INTERNAL_BASE_URL=

# -----------------------------------------------------------------------------
# アプリケーション設定
# -----------------------------------------------------------------------------
# local / staging / production
VITE_APP_ENV=development

# デバッグモード（本番ではfalse）
VITE_DEBUG=false

# -----------------------------------------------------------------------------
# エラー監視（Sentry）
# -----------------------------------------------------------------------------
# Sentry DSN（エラー監視を有効にする場合に設定）
# https://sentry.io で取得
VITE_SENTRY_DSN=

# アプリケーションバージョン（Sentryリリース識別用）
VITE_APP_VERSION=

# -----------------------------------------------------------------------------
# 外部サービス連携（オプション）
# -----------------------------------------------------------------------------
# Google Apps Script URL（スプレッドシート連携用）
VITE_GOOGLE_APPS_SCRIPT_URL=

# -----------------------------------------------------------------------------
# Supabase CLI用（ローカル開発・CI/CD用）
# -----------------------------------------------------------------------------
# Supabase Personal Access Token（Management API用）
# https://app.supabase.com/account/tokens で取得
# SUPABASE_ACCESS_TOKEN=
