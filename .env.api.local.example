# =============================================================================
# 手元の API サーバー（scripts/dev-api-server.mjs）用の環境変数
#
#   cp .env.api.local.example .env.api.local
#
# 値はすべてローカル Supabase（supabase start）の既定値。公開済みのデモ用キーで秘密ではない。
# staging・本番のキーはここに書かないこと（API サーバーは手元以外の Supabase には接続しない）。
# JWT secret を変えた場合は npm run supabase:status の値に差し替える。
# =============================================================================
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# CORS で許可する画面の URL（vite の既定ポート）
ALLOWED_ORIGIN=http://localhost:5173

# 任意（未設定なら該当機能は「未設定」として動く）
# FREEE_ACCESS_TOKEN=
# CANCELLATION_BILLING_SEND_ENABLED=false
# DEV_API_PORT=3000
